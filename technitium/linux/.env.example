# Valores literais: sem aspas, export ou expansões de shell.
DOMAIN=dns.trendsoftware.brasil
# Redes de administração do painel; podem ser diferentes das redes dos clientes DNS.
ACCESS_CIDRS=192.168.0.0/24
SSH_PORT=22
SSH_CIDRS=192.168.0.0/24
ARTIFACT_BASE_URL=http://cdn.trendsoftware.brasil/cdn/ubuntu26-amd64
ALLOW_HTTP_ARTIFACTS=true
MANIFEST_PATH=/home/trendsoftware/sdlc-manifest.json
TLS_CERT_PATH=
TLS_KEY_PATH=
# IP privado FIXO desta VM. Troque pelo IP definitivo; .250 é a VM de homologação.
DNS_LISTEN_IPV4=192.168.0.250
# Clientes DNS e recursão; /0 é recusado, independentemente da rede do painel.
DNS_CIDRS=192.168.0.0/24
# IPs dos resolvedores externos, via UDP. Vazio: resolução recursiva direta.
DNS_FORWARDERS=1.1.1.1,9.9.9.9
# Caminho ABSOLUTO para a cópia editada do JSON de registros iniciais.
DNS_RECORDS_PATH=/home/trendsoftware/sdlc-infrastructure/technitium/config/records.json
