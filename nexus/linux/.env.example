# Valores literais: sem aspas, export ou expansões de shell.
DOMAIN=nexus.exemplo.com
# Ajuste para as redes de clientes que devem acessar o proxy.
ACCESS_CIDRS=10.20.0.0/16
SSH_PORT=22
SSH_CIDRS=10.20.0.0/16
# Apache HTTPD local; o DNS precisa resolver somente para a rede privada.
ARTIFACT_BASE_URL=http://cdn.trendsoftware.brasil/cdn/ubuntu26-amd64
# HTTP local exige opt-in e manifesto entregue por canal confiável (SSH).
ALLOW_HTTP_ARTIFACTS=true
# Copie este manifesto da máquina que preparou os artefatos (canal confiável).
MANIFEST_PATH=/home/ubuntu/sdlc-manifest.json
# Vazio: certificado autoassinado para laboratório. Produção: certificado da sua CA.
TLS_CERT_PATH=
TLS_KEY_PATH=

